{
  "name": "openclaw-worldscribe",
  "version": "0.2.0",
  "description": "Agent-native OpenClaw memory: standalone evidence storage, scoped recall and verifiable maintenance",
  "type": "module",
  "license": "MIT",
  "private": false,
  "devDependencies": {
    "@types/node": "^22.20.1",
    "openclaw": "2026.9.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "zod": "^3.25.76"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "typebox": "1.3.18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Mazeye/openclaw-worldscribe"
  },
  "files": [
    "index.ts",
    "src",
    "dist",
    "skills",
    "docker",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE",
    "AGENTS.md",
    "docs",
    "scripts/e2e-local.mjs"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "manifest": "node --experimental-strip-types scripts/gen-manifest.ts",
    "check": "npm run typecheck && npm run manifest && npm run build && npm test",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "e2e:local": "node scripts/e2e-local.mjs",
    "e2e:legacy": "node scripts/e2e.mjs"
  },
  "peerDependencies": {
    "openclaw": ">=2026.9.3"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "compat": {
      "pluginApi": ">=2026.9.3",
      "minGatewayVersion": "2026.9.3"
    },
    "install": {
      "npmSpec": "openclaw-worldscribe",
      "defaultChoice": "npm"
    }
  },
  "engines": {
    "node": ">=22.16.0"
  }
}
